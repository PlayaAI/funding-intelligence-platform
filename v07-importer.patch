+}
+
+export interface FunderImportCandidate {
+  entity: "funder";
+  input: Omit<FunderInsert, "id" | "created_at" | "updated_at">;
+  raw: RawImportRow;
+}
+
+export type ImportCandidate = GrantImportCandidate | FunderImportCandidate;
+
+export interface DuplicateInfo {
+  id: string;
+  reason: string;
+  existing: GrantRow | FunderRow;
+}
+
+export interface ImportPreviewRow {
+  rowIndex: number;
+  status: ImportPreviewStatus;
+  displayName: string;
+  secondary: string | null;
+  candidate: ImportCandidate | null;
+  issues: ImportValidationIssue[];
+  duplicate: DuplicateInfo | null;
+  raw: RawImportRow;
+}
+
+export interface ImportPreviewSummary {
+  totalRows: number;
+  readyRows: number;
+  duplicateRows: number;
+  errorRows: number;
+  warningRows: number;
+  unknownColumns: string[];
+}
+
+export interface ImportPreview {
+  importType: ImportType;
+  entity: ImportEntity;
+  fileName: string;
+  rows: ImportPreviewRow[];
+  summary: ImportPreviewSummary;
+}
+
+export interface ImportRunRow {
+  id: string;
+  source: string;
+  import_type: ImportType | string;
+  file_name: string | null;
+  status: "completed" | "completed_with_errors" | "failed" | string;
+  total_rows: number;
+  created_count: number;
+  updated_count: number;
+  skipped_count: number;
+  error_count: number;
+  summary: Json | null;
+  created_by: string | null;
+  created_at: string;
+}
